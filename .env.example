# Copy to .env and fill in for local development.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base URL used to build absolute links inside emails (feedback, booking,
# unsubscribe). Point this at your real domain in production.
SITE_BASE_URL=http://127.0.0.1:8000

# SendGrid - leave blank to run in dry-run mode (emails are rendered and
# logged, never actually sent). The from-address must be a verified sender
# or authenticated domain in SendGrid, or sends are rejected with a 403.
SENDGRID_API_KEY=
EMAIL_FROM=Culture Digest <digest@example.com>

# AI assistance for interpreting reader free text, classifying opportunities
# and writing the "why this suits you" lines. Leave blank to run without it -
# everything falls back to the deterministic templates.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

RECOMMENDATIONS_PER_SEND=4
RECOMMENDATION_COOLDOWN_DAYS=60
